# loadtest/.env.loadtest.example
#
# Copy and source this before running, e.g.:
#   set -a; source loadtest/my.env; set +a; npm run loadtest:search
# or pass individual vars with `-e KEY=value` after the k6 command.
#
# k6 does NOT read .env files automatically. The npm scripts call `k6 run`,
# which inherits your shell environment, so exporting these works.

# Base URL of the target deployment. Default is local dev.
# NEVER point write tests at production.
BASE_URL=http://localhost:4000

# Free-form label for reporting only (local | preview | staging). Does not relax safety.
LOAD_TEST_MODE=local

# A test business + location with QUEUE and RESERVATIONS enabled.
# Use throwaway/seeded data, not a real paying customer's venue.
TEST_BUSINESS_USERNAME=demo
TEST_LOCATION_ID=000000000000000000000000

# A queueToken for the polling test. Get it from a queue-join response or DB
# after running loadtest:queue (or joining via the UI).
TEST_QUEUE_TOKEN=

# A FUTURE date/time for reservation contention (the slot everyone fights over).
TEST_RESERVATION_DATE=2026-12-31
TEST_RESERVATION_TIME=19:00

# REQUIRED for any write test (reservation/queue/ratelimit). Omit it and those
# tests refuse to run. Only set true for local/preview/staging.
# ALLOW_WRITE_LOAD_TEST=true

# Hosts that are ALWAYS production and can never be targeted by write tests,
# even with ALLOW_WRITE_LOAD_TEST=true. Comma-separated host substrings.
# Set this to your real production domain(s).
# PROD_URL_DENY=seatping.com,app.seatping.com
