{
  "buildCommand": "npx prisma migrate deploy && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && npx prisma generate",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/server"
    },
    {
      "source": "/api/blog/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/blog",
      "destination": "/api/server"
    },
    {
      "source": "/blog/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/server"
    },
    {
      "source": "/api/cron/ticket-email",
      "destination": "/api/server"
    },
    {
      "source": "/api/admin/blog/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/admin/blog/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/demo/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/admin",
      "destination": "/api/server"
    },
    {
      "source": "/admin/dashboard",
      "destination": "/api/server"
    },
    {
      "source": "/admin/customers",
      "destination": "/api/server"
    },
    {
      "source": "/admin/featured",
      "destination": "/api/server"
    },
    {
      "source": "/admin/templates",
      "destination": "/api/server"
    },
    {
      "source": "/admin/customer",
      "destination": "/api/server"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/feedback/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/locations/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/featured-restaurants/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/featured-restaurants",
      "destination": "/api/server"
    },
    {
      "source": "/api/restaurants/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/reservations/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/floor/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/performance/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/search/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/guests/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/guests",
      "destination": "/api/server"
    },
    {
      "source": "/api/campaigns/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/campaigns",
      "destination": "/api/server"
    },
    {
      "source": "/api/audiences/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/audiences",
      "destination": "/api/server"
    },
    {
      "source": "/api/jobs/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/tickets",
      "destination": "/api/server"
    },
    {
      "source": "/tickets/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/health",
      "destination": "/api/server"
    },
    {
      "source": "/business",
      "destination": "/api/server"
    },
    {
      "source": "/business/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/:path*",
      "destination": "/api/server"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/credit-refill",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/server.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/business/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/profile",
