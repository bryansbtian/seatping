{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && npx prisma generate",
  "devCommand": "npm run dev",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/sales/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/feedback/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/locations/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/featured-restaurants/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/featured-restaurants",
      "destination": "/api/server"
    },
    {
      "source": "/api/restaurants/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/reservations/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/search/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/guests/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/guests",
      "destination": "/api/server"
    },
    {
      "source": "/api/campaigns/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/campaigns",
      "destination": "/api/server"
    },
    {
      "source": "/api/audiences/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/audiences",
      "destination": "/api/server"
    },
    {
      "source": "/api/jobs/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/tickets",
      "destination": "/api/server"
    },
    {
      "source": "/tickets/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/api/health",
      "destination": "/api/server"
    },
    {
      "source": "/business",
      "destination": "/api/server"
    },
    {
      "source": "/business/:path*",
      "destination": "/api/server"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/credit-refill",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/server.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
