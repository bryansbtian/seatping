# SeatPing environment variables.
# Copy this file to .env and fill in real values. Never commit your .env.
# Optional providers fail gracefully when unset; a minimal local setup needs
# only DATABASE_URL, DIRECT_URL, JWT_SECRET, ADMIN_USERNAME, and ADMIN_PASSWORD_HASH.

# --- Runtime ---
# "development" locally, "production" in deployed environments. Controls static serving + secure cookies.
NODE_ENV=development
# Public origin of the app. Used to build absolute links; usually same as FRONTEND_URL.
APP_ORIGIN=http://localhost:8080
# Public frontend origin, used to build links in notification messages.
FRONTEND_URL=http://localhost:8080
# API port. Defaults to 4000 if unset.
PORT=4000
# Allowed CORS origin (the frontend URL). Set to your deployed domain in production.
CLIENT_ORIGIN=http://localhost:8080

# --- Database ---
# PostgreSQL connection string used at runtime. On Supabase, the Supavisor pooler URL (port 6543) with ?pgbouncer=true.
DATABASE_URL=
# PostgreSQL connection string for Prisma migrations only. On Supabase, the session-mode URL (port 5432).
DIRECT_URL=

# --- Auth ---
# JWT lifetime, e.g. 7d, 24h. Optional; defaults to 7d.
JWT_EXPIRES_IN=7d
# Secret for signing auth JWTs. Generate a random string: `openssl rand -hex 32`.
JWT_SECRET=

# --- Email (SMTP) ---
# SMTP host for the email sender. Defaults exist in server/lib/email.ts (a Porkbun host).
EMAIL_HOST=
# SMTP login mailbox and sender address for all outgoing emails.
EMAIL_USER=
# SMTP password for the email sender mailbox. Get this from your email/SMTP provider.
EMAIL_PASSWORD=
# Support contact shown in outgoing emails. Public Help, Terms, and Policy pages retain their existing address.
# When unset, outgoing emails omit support email links.
SUPPORT_EMAIL=

# --- SMS (Telnyx) --- Optional
# API key from the Telnyx portal: https://portal.telnyx.com > API Keys.
TELNYX_API_KEY=
# A messaging-enabled number purchased in Telnyx (E.164 format, e.g. +15551234567).
TELNYX_PHONE_NUMBER=

# --- WhatsApp (Kapso) --- Optional
# WhatsApp phone number ID from the Kapso dashboard: https://kapso.ai
KAPSO_PHONE_NUMBER_ID=
# API key from the Kapso dashboard.
KAPSO_API_KEY=
# WhatsApp Business Account (WABA) ID from the Kapso dashboard.
KAPSO_WABA_ID=

# --- Google Maps / Calendar / Analytics --- Optional
# Google Maps JavaScript + Places API key: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
# Server-only OAuth Web Application client ID: https://console.cloud.google.com/auth/clients
GOOGLE_CALENDAR_CLIENT_ID=
# Matching OAuth client secret, saved when creating the client. Never prefix Calendar credentials with VITE_.
GOOGLE_CALENDAR_CLIENT_SECRET=
# Offline refresh token authorized by the calendar owner. Setup: docs/demo-booking.md.
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Primary calendar ID from Google Calendar > Settings > Integrate Calendar. Authorize OAuth with its owner.
GOOGLE_CALENDAR_ID=
# GA4 measurement ID (G-XXXXXXXXXX) from https://analytics.google.com > Admin > Data Streams.
VITE_GA_MEASUREMENT_ID=

# --- Cloudinary (Image Uploads) --- Optional
# Found on the Cloudinary dashboard: https://console.cloudinary.com > Dashboard.
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_SECRET=

# --- Upstash QStash (Async Jobs + Sub-Daily Schedules) --- Optional
# Create a QStash instance at https://console.upstash.com/qstash and copy these from the dashboard.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Shared secret that authorizes the cron endpoints (sent as Authorization: Bearer <secret>).
# Generate a random string: `openssl rand -hex 32`. Required for crons to run.
CRON_SECRET=

# --- Upstash Redis (Distributed Rate Limiting) --- Optional
# Create a Redis database at https://console.upstash.com and copy the REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Admin Console ---
# Username for the /admin console login. Choose any value.
ADMIN_USERNAME=
# bcrypt hash of the admin password (not the plaintext). Generate with:
# node -e 'console.log(require("bcrypt").hashSync(process.argv[1],12))' 'your-password'
ADMIN_PASSWORD_HASH=