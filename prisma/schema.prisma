generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  username  String   @unique
  email     String   @unique
  phone     String
  password  String

  // Customer activity stored inline as JSON for now (reservations + queueing are
  // still early). Each item also carries denormalized business details so cards
  // render without a join; `businessUsername` lets us fetch the business/location
  // profile image later. See src/pages/Profile.tsx for item shapes.
  upcomingReservations Json @default("[]")
  pastReservations     Json @default("[]")
  queueingActivity     Json @default("[]")

  // Restaurants the customer bookmarked, newest first. Each item is
  // denormalized so a card renders without a join:
  // { id, businessUsername, businessName?, locationName?, area?, city?, savedAt }.
  // `id`/dedup key is `businessUsername` (one save per business).
  savedRestaurants     Json @default("[]")

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Business {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String
  username String @unique
  email    String @unique
  phone    String
  password String

  // No plans — billing is manual. Every business starts on a 7-day trial with
  // 300 base credits and 1 location, and is activated by an admin turning
  // `trial` off (which anchors the monthly refill via `creditsStartedAt`).
  trial             Boolean @default(true)
  trialDurationDays Int     @default(7)
  maxLocations      Int     @default(1)

  baseCredits Int @default(300)

  // Operator UI language for the business dashboard area (/business/*). "en" or
  // "id". Optional so legacy documents that predate this field read back as null
  // and fall back to English in code. New businesses default to English.
  language String? @default("en")

  // Anchor for the monthly credit-refill cycle. Set to the activation moment
  // when an admin turns `trial` off; null while on trial. (Formerly planStartedAt.)
  creditsStartedAt    DateTime?
  lastCreditRefillAt  DateTime?
  nextCreditRefillAt  DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  // Homepage "Featured Restaurants" entries owned by this business (admin-curated).
  featured FeaturedRestaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

model Location {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?

  name    String?
  // Customer-facing short label shown when joining a queue / booking (e.g.
  // "Senopati", "PIK", "Main Branch"). Labeled "Location Display Name" in the UI.
  displayName String?
  address String

  // Google Places address details (captured from autocomplete; all optional so
  // manually-typed addresses still work).
  area          String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?
  googlePlaceId String?
  googleMapsUrl String?

  // Live queue state lives in the QueueEntry model; reservations in the
  // Reservation model. The former Location.queue / admittedCustomers /
  // removedCustomers / reservations JSON arrays were removed in Phase 7 (their
  // raw data remains in existing Mongo documents, just unmapped).

  // Unified credits. Consumed only when a customer chooses "Wait Anywhere"
  // (1 credit, any channel). `baseCredits` is the monthly refill target.
  credits     Int @default(0)
  baseCredits Int @default(0)

  queueEnabled        Boolean @default(true)
  reservationsEnabled Boolean @default(true)

  reservationSettings Json @default("{}")
  restaurantProfile   Json @default("{}")

  // Denormalized from restaurantProfile.isPublished so search/suggestions can
  // filter at the DB level (indexed) instead of loading every location. Kept in
  // sync wherever the restaurant profile is saved.
  isPublished Boolean @default(false)

  // Hero/banner image for the public location page (one per location). Uploaded
  // to Cloudinary from the backend; `publicId` lets us delete the old asset when
  // the banner is replaced or removed. Gallery photos live in the Photo model.
  bannerImageUrl      String?
  bannerImagePublicId String?

  // Gallery photos (max 10 per location, enforced in the upload route).
  photos Photo[]

  // Customer reviews for this location (viewed by the owner in the dashboard).
  reviews Review[]

  // Homepage "Featured Restaurants" entry for this location, if any (admin-curated).
  featured FeaturedRestaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
  @@index([businessId])
  @@index([businessUsername])
  @@index([isPublished])
}

/// Gallery image for a location's public page. Files live in Cloudinary; only
/// the URL + Cloudinary `publicId` (for deletion) are stored here.
model Photo {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  locationId String   @db.ObjectId
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  url      String
  publicId String
  altText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
  @@index([locationId])
}

/// Customer review for a location. Created by the customer feedback flow (once
/// built) and viewed by the business owner in the dashboard. Customer display
/// fields are denormalized so a review renders without a join to `users`.
model Review {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  locationId String  @db.ObjectId
  customerId String? @db.ObjectId

  customerName     String?
  customerUsername String?
  rating           Int
  description      String?

  // Optional visit context, populated when a review comes from a queue/booking
  // completion flow. Rendered only when present.
  partySize    Int?
  serviceType  String?

  // Single business-owner reply per review. Customers cannot see edit/delete
  // controls — those are owner-only via PATCH/DELETE on the reply route.
  businessReply          String?
  businessReplyCreatedAt DateTime?
  businessReplyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@index([locationId])
  @@index([customerId])
}

/// Admin-curated homepage feature. `businessId` is the owning business (this
/// app's "user" for business accounts); one feature per location (@@unique).
model FeaturedRestaurant {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  businessId String @db.ObjectId
  locationId String @db.ObjectId

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId])
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("featured_restaurants")
}

model Ticket {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber  String   @unique
  type          String
  status        String   @default("open")
  priority      String?
  subject       String
  senderName    String
  senderEmail   String
  senderPhone   String?
  businessName  String?
  data          Json
  messages      Json     @default("[]")
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tickets")
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ===========================================================================
// Scalability models (Phase 1+). High-contention queue + reservation state was
// previously stored as Json arrays on Location, which forced read-modify-write
// updates that lost entries and overbooked under concurrency. These models give
// us indexed, atomically-updatable rows. The legacy Json fields on Location are
// kept as a fallback until the migration is verified in production.
// ===========================================================================

/// One person/party in a location's waitlist. The full lifecycle lives on a
/// single row so transitions are atomic, status-guarded updates (no array RMW).
enum QueueStatus {
  WAITING
  ADMITTED
  ARRIVED
  NO_SHOW
  REMOVED
  LEFT
}

model QueueEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Customer-facing token used by the live status page. Stable per ticket.
  queueToken String @unique
  // firstName+lastName+joinedAt — the composite id the (unchanged) dashboard
  // sends to admit/remove/arrival/no-show endpoints. Indexed for O(1) resolve.
  legacyKey String

  locationId String  @db.ObjectId
  businessId String  @db.ObjectId
  // Logged-in customer who joined, if any (guests are null).
  customerId String? @db.ObjectId

  firstName          String
  lastName           String
  guestCount         Int
  notificationMethod String
  phone              String?
  countryCode        String?
  email              String?
  // SMS consent captured at join time (compliance). Persisted, not just echoed.
  smsConsent          Boolean @default(false)
  smsMarketingConsent Boolean @default(false)

  status      QueueStatus @default(WAITING)
  // Mirrors the legacy admitted-record sub-status ("pending" | "arrived" |
  // "no_show") so the reconstructed admittedCustomers array is byte-compatible.
  finalStatus String?

  joinedAt   DateTime
  admittedAt DateTime?
  arrivedAt  DateTime?
  noShowAt   DateTime?
  removedAt  DateTime?
  leftAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([businessId])
  @@index([legacyKey])
  @@index([customerId])
  @@map("queue_entries")
}

/// A booking. PENDING/ARRIVED are retained beyond the four core statuses to
/// preserve existing capacity logic (ACTIVE = PENDING|CONFIRMED|ARRIVED) and the
/// dashboard's arrival/no-show/complete transitions.
enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  manageToken      String  @unique
  locationId       String  @db.ObjectId
  businessId       String  @db.ObjectId
  businessUsername String?
  customerId       String? @db.ObjectId

  firstName     String
  lastName      String
  name          String?
  guestCount    Int // == legacy partySize
  email         String
  phone         String?
  countryCode   String?
  contactMethod String?

  // Naive local wall-clock "YYYY-MM-DDTHH:MM" (unchanged convention).
  reservationDateTime String
  status              ReservationStatus @default(CONFIRMED)
  notes               String?
  source              String?

  reminderEmailSentAt DateTime?
  cancelledAt         DateTime?
  arrivedAt           DateTime?
  completedAt         DateTime?
  noShowAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([businessId])
  @@index([reservationDateTime])
  @@index([customerId])
  @@map("reservations_v2")
}

/// Guest CRM profile (Phase 3 / P3A). One row per (business + location +
/// real customer), built automatically from QueueEntry + Reservation rows. A
/// guest is matched/merged by normalized phone and/or normalized email so the
/// same person doesn't get duplicate profiles. Denormalized counts + dates are
/// recomputed from the referenced source rows (sourceQueueEntryIds /
/// sourceReservationIds) so they stay deterministic and never drift. Scoped by
/// businessId on every query so one business can never see another's guests.
model GuestProfile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?
  locationId       String  @db.ObjectId

  firstName String?
  lastName  String?
  fullName  String?

  // Raw contact (most recent seen) + normalized match keys (digits-only phone,
  // lowercased/trimmed email). Matching/merging is done on the normalized keys.
  phone           String?
  email           String?
  normalizedPhone String?
  normalizedEmail String?

  // Business-editable custom tags (e.g. "VIP", "Allergy"). "New"/"Returning"
  // are NOT stored here — they're derived from totalVisits at read time.
  tags    String[] @default([])
  notes   String?
  // Deterministic, generated-from-history summary (no external AI).
  summary String?

  totalVisits              Int @default(0)
  firstVisitAt             DateTime?
  lastVisitAt              DateTime?
  upcomingReservationCount Int @default(0)
  pastReservationCount     Int @default(0)
  waitlistVisitCount       Int @default(0)
  noShowCount              Int @default(0)
  cancelledCount           Int @default(0)

  // Source references — the rows this profile aggregates. Recompute reloads
  // these by id, so status changes on the source rows flow through on touch.
  sourceReservationIds String[] @default([])
  sourceQueueEntryIds  String[] @default([])

  // Marketing consent / opt-out (Phase 3B / Campaigns). Sending is conservative:
  // a guest is excluded from a channel whenever its opt-out timestamp is set.
  // The opt-in booleans default true (single opt-in posture for existing guests)
  // and exist so an explicit double opt-in flow can flip them later without a
  // schema change. `marketingOptOutAt` is a global "stop everything" stamp.
  emailMarketingOptIn       Boolean   @default(true)
  whatsappMarketingOptIn    Boolean   @default(true)
  smsMarketingOptIn         Boolean   @default(true)
  emailMarketingOptOutAt    DateTime?
  whatsappMarketingOptOutAt DateTime?
  smsMarketingOptOutAt      DateTime?
  marketingOptOutAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([locationId])
  @@index([businessId, locationId])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([tags])
  @@index([lastVisitAt])
  @@index([fullName])
  @@map("guest_profiles")
}

// ===========================================================================
// Guest Campaigns (Phase 3B). Businesses send SeatPing-branded Email / WhatsApp
// / SMS campaigns to their guests, always "on behalf of" the restaurant. Every
// channel must use a TEMPLATE — businesses never free-type an instant blast.
//
// Two template kinds:
//   - SEATPING: curated + pre-approved by SeatPing, usable immediately.
//   - CUSTOM:   one general request the business submits; SeatPing admin reviews
//               it and prepares Email/SMS/WhatsApp (incl. Meta) internally. It is
//               all-or-nothing: APPROVED means usable for ALL three channels.
// Admin-only Meta tracking fields live on the same row but are never exposed to
// the business-facing UI/serializers.
// ===========================================================================

enum CampaignChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum CampaignTemplateType {
  SEATPING
  CUSTOM
}

enum CampaignTemplateApprovalStatus {
  DRAFT
  PENDING_SEATPING_REVIEW
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
  RECURRING
  PAUSED
}

enum CampaignSendMode {
  NOW
  SCHEDULED
  RECURRING
}

enum CampaignFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum CampaignRunType {
  MANUAL
  SCHEDULED
  RECURRING
}

enum CampaignRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

/// A reusable campaign template. SeatPing templates have a null businessId;
/// custom templates are owned by the submitting business. `body` is the shared
/// message used to render all three channels; `variables` lists the fillable
/// placeholders (e.g. ["firstName","offer"]).
model CampaignTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Null for SeatPing-provided templates; set for business-submitted custom ones.
  businessId       String? @db.ObjectId
  businessUsername String?
  locationId       String? @db.ObjectId

  templateType   CampaignTemplateType
  name           String
  // Internal Meta-safe identifier derived from `name` (lowercase a-z0-9_). Used
  // as the WhatsApp template name admins create in Meta. Globally unique for
  // SeatPing templates; unique per business for custom ones (suffix _2, _3...).
  slug           String?
  purpose        String?
  body           String
  offerDetails   String?
  ctaText        String?
  ctaUrl         String?
  variables      String[] @default([])
  exampleValues  Json     @default("{}")

  approvalStatus CampaignTemplateApprovalStatus @default(DRAFT)
  rejectionReason String?

  // SeatPing templates are sorted/grouped for the picker; higher = first.
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  // ---- Admin-only internal fields (never serialized to the business UI) ----
  internalReviewNotes          String?
  whatsappMetaStatus           String?
  whatsappProviderTemplateName String?
  whatsappProviderTemplateId   String?
  whatsappMetaCategory         String?
  whatsappLanguage             String? @default("en")
  whatsappSubmittedAt          DateTime?
  whatsappApprovedAt           DateTime?
  whatsappRejectedAt           DateTime?
  approvedBy                   String?
  rejectedBy                   String?

  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([templateType])
  @@index([approvalStatus])
  @@index([slug])
  @@map("campaign_templates")
}

/// One campaign send (or draft). Scoped by business + location.
model Campaign {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?
  locationId       String  @db.ObjectId

  name       String
  channel    CampaignChannel
  templateId String          @db.ObjectId

  // Variable values the business filled for this campaign's template.
  templateValues Json @default("{}")

  // Audience: a smart group key (e.g. "not_returned_30d") or "manual".
  audienceType   String
  audienceConfig Json   @default("{}")

  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0)
  excludedCount  Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  skippedCount   Int            @default(0)

  // ---- Timing (Phase 3B+) ----
  // sendMode drives how the campaign is dispatched. SCHEDULED/RECURRING are
  // picked up by the campaigns cron sweep when nextRunAt is due. Times are real
  // UTC instants; `timezone` is the location's IANA zone used to interpret the
  // operator's chosen wall-clock and to render it back.
  sendMode  CampaignSendMode @default(NOW)
  timezone  String?
  scheduledAt DateTime?

  recurrenceFrequency CampaignFrequency?
  recurrenceStartAt   DateTime?
  recurrenceEndAt     DateTime?
  // Per-guest throttle for recurring campaigns: a guest won't be re-sent this
  // campaign within this many days (default applied in code).
  maxSendsPerGuestWindowDays Int?

  nextRunAt DateTime?
  lastRunAt DateTime?
  isPaused  Boolean   @default(false)

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([businessId])
  @@index([businessId, locationId])
  @@index([status])
  @@index([nextRunAt])
  @@map("campaigns")
}

/// One execution of a campaign (manual send, scheduled fire, or a single
/// recurring run). Holds that run's resolved counts + status so recurring
/// campaigns keep a full per-run history.
model CampaignRun {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId String @db.ObjectId
  businessId String @db.ObjectId

  runType      CampaignRunType
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  status         CampaignRunStatus @default(PENDING)
  recipientCount Int               @default(0)
  sentCount      Int               @default(0)
  failedCount    Int               @default(0)
  skippedCount   Int               @default(0)
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([businessId])
  @@map("campaign_runs")
}

/// One resolved recipient of a campaign. Created at send time; carries the
/// snapshot contact + per-recipient delivery state. A unique (campaignId,
/// guestProfileId) guard prevents duplicate sends if /send is called twice.
model CampaignRecipient {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId     String  @db.ObjectId
  // The run this recipient belongs to. Dedup + counts are scoped per-run so a
  // recurring campaign can send to the same guest across different runs.
  runId          String  @db.ObjectId
  businessId     String  @db.ObjectId
  guestProfileId String  @db.ObjectId

  channel CampaignChannel
  email   String?
  phone   String?

  status       CampaignRecipientStatus @default(PENDING)
  skipReason   String?
  errorMessage String?

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A guest appears at most once per run (idempotent against a double fire).
  @@unique([runId, guestProfileId])
  @@index([campaignId])
  @@index([runId])
  @@index([businessId])
  @@index([campaignId, guestProfileId])
  @@map("campaign_recipients")
}

/// Append-only delivery event log for a campaign (provider acks, errors, etc).
model CampaignDeliveryLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId  String  @db.ObjectId
  recipientId String? @db.ObjectId

  eventType         String
  providerMessageId String?
  message           String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([recipientId])
  @@map("campaign_delivery_logs")
}

/// Atomic per-hour reservation capacity counter — the overbooking guard. A
/// single-document conditional `$inc` enforces maxReservedGuestsPerHour without
/// a transaction, so concurrent bookings can never exceed the cap.
model SlotCounter {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  locationId     String @db.ObjectId
  dateKey        String // "YYYY-MM-DD"
  hour           Int // 0-23
  reservedGuests Int    @default(0)

  @@unique([locationId, dateKey, hour])
  @@map("slot_counters")
}

/// A reusable custom audience group created by the business.
model SavedAudience {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?
  locationId       String  @db.ObjectId

  name        String
  description String?
  filters     Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, locationId])
  @@map("saved_audiences")
}
