generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  username  String   @unique
  email     String   @unique
  phone     String
  password  String

  // Customer activity stored inline as JSON for now (reservations + queueing are
  // still early). Each item also carries denormalized business details so cards
  // render without a join; `businessUsername` lets us fetch the business/location
  // profile image later. See src/pages/Profile.tsx for item shapes.
  upcomingReservations Json @default("[]")
  pastReservations     Json @default("[]")
  queueingActivity     Json @default("[]")

  // Restaurants the customer bookmarked, newest first. Each item is
  // denormalized so a card renders without a join:
  // { id, businessUsername, businessName?, locationName?, area?, city?, savedAt }.
  // `id`/dedup key is `businessUsername` (one save per business).
  savedRestaurants     Json @default("[]")

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Business {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String
  username String @unique
  email    String @unique
  phone    String
  password String

  // No plans — billing is manual. Every business starts on a 7-day trial with
  // 300 base credits and 1 location, and is activated by an admin turning
  // `trial` off (which anchors the monthly refill via `creditsStartedAt`).
  trial             Boolean @default(true)
  trialDurationDays Int     @default(7)
  maxLocations      Int     @default(1)

  baseCredits Int @default(300)

  // Operator UI language for the business dashboard area (/business/*). "en" or
  // "id". Optional so legacy documents that predate this field read back as null
  // and fall back to English in code. New businesses default to English.
  language String? @default("en")

  // Anchor for the monthly credit-refill cycle. Set to the activation moment
  // when an admin turns `trial` off; null while on trial. (Formerly planStartedAt.)
  creditsStartedAt    DateTime?
  lastCreditRefillAt  DateTime?
  nextCreditRefillAt  DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  // Homepage "Featured Restaurants" entries owned by this business (admin-curated).
  featured FeaturedRestaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

model Location {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?

  name    String?
  // Customer-facing short label shown when joining a queue / booking (e.g.
  // "Senopati", "PIK", "Main Branch"). Labeled "Location Display Name" in the UI.
  displayName String?
  address String

  // Google Places address details (captured from autocomplete; all optional so
  // manually-typed addresses still work).
  area          String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?
  googlePlaceId String?
  googleMapsUrl String?

  // Live queue state lives in the QueueEntry model; reservations in the
  // Reservation model. The former Location.queue / admittedCustomers /
  // removedCustomers / reservations JSON arrays were removed in Phase 7 (their
  // raw data remains in existing Mongo documents, just unmapped).

  // Unified credits. Consumed only when a customer chooses "Wait Anywhere"
  // (1 credit, any channel). `baseCredits` is the monthly refill target.
  credits     Int @default(0)
  baseCredits Int @default(0)

  queueEnabled        Boolean @default(true)
  reservationsEnabled Boolean @default(true)

  reservationSettings Json @default("{}")
  restaurantProfile   Json @default("{}")

  // Denormalized from restaurantProfile.isPublished so search/suggestions can
  // filter at the DB level (indexed) instead of loading every location. Kept in
  // sync wherever the restaurant profile is saved.
  isPublished Boolean @default(false)

  // Hero/banner image for the public location page (one per location). Uploaded
  // to Cloudinary from the backend; `publicId` lets us delete the old asset when
  // the banner is replaced or removed. Gallery photos live in the Photo model.
  bannerImageUrl      String?
  bannerImagePublicId String?

  // Gallery photos (max 10 per location, enforced in the upload route).
  photos Photo[]

  // Customer reviews for this location (viewed by the owner in the dashboard).
  reviews Review[]

  // Homepage "Featured Restaurants" entry for this location, if any (admin-curated).
  featured FeaturedRestaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
  @@index([businessId])
  @@index([businessUsername])
  @@index([isPublished])
}

/// Gallery image for a location's public page. Files live in Cloudinary; only
/// the URL + Cloudinary `publicId` (for deletion) are stored here.
model Photo {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  locationId String   @db.ObjectId
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  url      String
  publicId String
  altText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
  @@index([locationId])
}

/// Customer review for a location. Created by the customer feedback flow (once
/// built) and viewed by the business owner in the dashboard. Customer display
/// fields are denormalized so a review renders without a join to `users`.
model Review {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  locationId String  @db.ObjectId
  customerId String? @db.ObjectId

  customerName     String?
  customerUsername String?
  rating           Int
  description      String?

  // Optional visit context, populated when a review comes from a queue/booking
  // completion flow. Rendered only when present.
  partySize    Int?
  serviceType  String?

  // Single business-owner reply per review. Customers cannot see edit/delete
  // controls — those are owner-only via PATCH/DELETE on the reply route.
  businessReply          String?
  businessReplyCreatedAt DateTime?
  businessReplyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@index([locationId])
  @@index([customerId])
}

/// Admin-curated homepage feature. `businessId` is the owning business (this
/// app's "user" for business accounts); one feature per location (@@unique).
model FeaturedRestaurant {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  businessId String @db.ObjectId
  locationId String @db.ObjectId

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId])
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("featured_restaurants")
}

model Ticket {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber  String   @unique
  type          String
  status        String   @default("open")
  priority      String?
  subject       String
  senderName    String
  senderEmail   String
  senderPhone   String?
  businessName  String?
  data          Json
  messages      Json     @default("[]")
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tickets")
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ===========================================================================
// Scalability models (Phase 1+). High-contention queue + reservation state was
// previously stored as Json arrays on Location, which forced read-modify-write
// updates that lost entries and overbooked under concurrency. These models give
// us indexed, atomically-updatable rows. The legacy Json fields on Location are
// kept as a fallback until the migration is verified in production.
// ===========================================================================

/// One person/party in a location's waitlist. The full lifecycle lives on a
/// single row so transitions are atomic, status-guarded updates (no array RMW).
enum QueueStatus {
  WAITING
  ADMITTED
  ARRIVED
  NO_SHOW
  REMOVED
  LEFT
}

model QueueEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Customer-facing token used by the live status page. Stable per ticket.
  queueToken String @unique
  // firstName+lastName+joinedAt — the composite id the (unchanged) dashboard
  // sends to admit/remove/arrival/no-show endpoints. Indexed for O(1) resolve.
  legacyKey String

  locationId String  @db.ObjectId
  businessId String  @db.ObjectId
  // Logged-in customer who joined, if any (guests are null).
  customerId String? @db.ObjectId

  firstName          String
  lastName           String
  guestCount         Int
  notificationMethod String
  phone              String?
  countryCode        String?
  email              String?
  // SMS consent captured at join time (compliance). Persisted, not just echoed.
  smsConsent          Boolean @default(false)
  smsMarketingConsent Boolean @default(false)

  status      QueueStatus @default(WAITING)
  // Mirrors the legacy admitted-record sub-status ("pending" | "arrived" |
  // "no_show") so the reconstructed admittedCustomers array is byte-compatible.
  finalStatus String?

  joinedAt   DateTime
  admittedAt DateTime?
  arrivedAt  DateTime?
  noShowAt   DateTime?
  removedAt  DateTime?
  leftAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([businessId])
  @@index([legacyKey])
  @@index([customerId])
  @@map("queue_entries")
}

/// A booking. PENDING/ARRIVED are retained beyond the four core statuses to
/// preserve existing capacity logic (ACTIVE = PENDING|CONFIRMED|ARRIVED) and the
/// dashboard's arrival/no-show/complete transitions.
enum ReservationStatus {
  PENDING
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  manageToken      String  @unique
  locationId       String  @db.ObjectId
  businessId       String  @db.ObjectId
  businessUsername String?
  customerId       String? @db.ObjectId

  firstName     String
  lastName      String
  name          String?
  guestCount    Int // == legacy partySize
  email         String
  phone         String?
  countryCode   String?
  contactMethod String?

  // Naive local wall-clock "YYYY-MM-DDTHH:MM" (unchanged convention).
  reservationDateTime String
  status              ReservationStatus @default(CONFIRMED)
  notes               String?
  source              String?

  reminderEmailSentAt DateTime?
  cancelledAt         DateTime?
  arrivedAt           DateTime?
  completedAt         DateTime?
  noShowAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([businessId])
  @@index([reservationDateTime])
  @@index([customerId])
  @@map("reservations_v2")
}

/// Guest CRM profile (Phase 3 / P3A). One row per (business + location +
/// real customer), built automatically from QueueEntry + Reservation rows. A
/// guest is matched/merged by normalized phone and/or normalized email so the
/// same person doesn't get duplicate profiles. Denormalized counts + dates are
/// recomputed from the referenced source rows (sourceQueueEntryIds /
/// sourceReservationIds) so they stay deterministic and never drift. Scoped by
/// businessId on every query so one business can never see another's guests.
model GuestProfile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?
  locationId       String  @db.ObjectId

  firstName String?
  lastName  String?
  fullName  String?

  // Raw contact (most recent seen) + normalized match keys (digits-only phone,
  // lowercased/trimmed email). Matching/merging is done on the normalized keys.
  phone           String?
  email           String?
  normalizedPhone String?
  normalizedEmail String?

  // Business-editable custom tags (e.g. "VIP", "Allergy"). "New"/"Returning"
  // are NOT stored here — they're derived from totalVisits at read time.
  tags    String[] @default([])
  notes   String?
  // Deterministic, generated-from-history summary (no external AI).
  summary String?

  totalVisits              Int @default(0)
  firstVisitAt             DateTime?
  lastVisitAt              DateTime?
  upcomingReservationCount Int @default(0)
  pastReservationCount     Int @default(0)
  waitlistVisitCount       Int @default(0)
  noShowCount              Int @default(0)
  cancelledCount           Int @default(0)

  // Source references — the rows this profile aggregates. Recompute reloads
  // these by id, so status changes on the source rows flow through on touch.
  sourceReservationIds String[] @default([])
  sourceQueueEntryIds  String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([locationId])
  @@index([businessId, locationId])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([tags])
  @@index([lastVisitAt])
  @@index([fullName])
  @@map("guest_profiles")
}

/// Atomic per-hour reservation capacity counter — the overbooking guard. A
/// single-document conditional `$inc` enforces maxReservedGuestsPerHour without
/// a transaction, so concurrent bookings can never exceed the cap.
model SlotCounter {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  locationId     String @db.ObjectId
  dateKey        String // "YYYY-MM-DD"
  hour           Int // 0-23
  reservedGuests Int    @default(0)

  @@unique([locationId, dateKey, hour])
  @@map("slot_counters")
}
