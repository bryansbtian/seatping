generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  username  String   @unique
  email     String   @unique
  phone     String
  password  String
  customerId        String?
  plan              String?
  locations         Json     @default("[]")
  trial             Boolean  @default(true)
  trialDurationDays Int      @default(7)
  maxLocations      Int      @default(1)
  baseCustomerCredits Int    @default(50)
  baseSMSCredits    Int      @default(200)
  planStartedAt     DateTime?
  lastCreditRefillAt DateTime?
  nextCreditRefillAt DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("users")
}

model Ticket {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber  String   @unique
  type          String   // "sales" or "feedback"
  status        String   @default("open") // "open", "in_progress", "closed"
  priority      String?  // "low", "medium", "high"
  subject       String
  senderName    String
  senderEmail   String
  senderPhone   String?
  businessName  String?
  data          Json     // Store full request data (SalesInquiryData or FeedbackData)
  messages      Json     @default("[]") // Array of {sender, message, timestamp, isTeamResponse}
  assignedTo    String?  // Name of team member handling ticket
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tickets")
  @@index([status])
  @@index([type])
  @@index([createdAt])
}
