generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  username  String   @unique
  email     String   @unique
  phone     String
  password  String

  upcomingReservations Json @default("[]")
  pastReservations     Json @default("[]")
  queueingActivity     Json @default("[]")

  savedRestaurants     Json @default("[]")

  resetToken       String?
  resetTokenExpiry DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Business {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  name     String
  username String @unique
  email    String @unique
  phone    String
  password String

  trial             Boolean @default(true)
  trialDurationDays Int     @default(7)
  maxLocations      Int     @default(1)

  baseCredits Int @default(300)

  language String? @default("en")

  creditsStartedAt    DateTime?
  lastCreditRefillAt  DateTime?
  nextCreditRefillAt  DateTime?

  resetToken       String?
  resetTokenExpiry DateTime?

  featured FeaturedRestaurant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

model Location {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?

  name    String?
  displayName String?
  address String

  area          String?
  city          String?
  country       String?
  latitude      Float?
  longitude     Float?
  googlePlaceId String?
  googleMapsUrl String?

  credits     Int @default(0)
  baseCredits Int @default(0)

  queueEnabled        Boolean @default(true)
  reservationsEnabled Boolean @default(true)

  reservationSettings Json @default("{}")
  restaurantProfile   Json @default("{}")

  isPublished Boolean @default(false)

  bannerImageUrl      String?
  bannerImagePublicId String?

  photos Photo[]

  reviews Review[]

  featured FeaturedRestaurant[]

  floorPlans FloorPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("locations")
  @@index([businessId])
  @@index([businessUsername])
  @@index([isPublished])
}

model Photo {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  locationId String   @db.ObjectId
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  url      String
  publicId String
  altText  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
  @@index([locationId])
}

model Review {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  locationId String  @db.ObjectId
  customerId String? @db.ObjectId

  customerName     String?
  customerUsername String?
  rating           Int
  description      String?

  partySize    Int?
  serviceType  String?

  businessReply          String?
  businessReplyCreatedAt DateTime?
  businessReplyUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@index([locationId])
  @@index([customerId])
}

model FeaturedRestaurant {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  businessId String @db.ObjectId
  locationId String @db.ObjectId

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId])
  @@index([businessId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("featured_restaurants")
}

model Ticket {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber  String   @unique
  type          String
  status        String   @default("open")
  priority      String?
  subject       String
  senderName    String
  senderEmail   String
  senderPhone   String?
  businessName  String?
  data          Json
  messages      Json     @default("[]")
  assignedTo    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("tickets")
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

enum QueueStatus {
  WAITING
  ADMITTED
  ARRIVED
  NO_SHOW
  REMOVED
  LEFT
}

model QueueEntry {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  queueToken String @unique
  legacyKey String

  locationId String  @db.ObjectId
  businessId String  @db.ObjectId
  customerId String? @db.ObjectId

  firstName          String
  lastName           String
  guestCount         Int
  notificationMethod String
  phone              String?
  countryCode        String?
  email              String?
  smsConsent          Boolean @default(false)
  smsMarketingConsent Boolean @default(false)

  status      QueueStatus @default(WAITING)
  finalStatus String?

  joinedAt   DateTime
  admittedAt DateTime?
  arrivedAt  DateTime?
  noShowAt   DateTime?
  removedAt  DateTime?
  leftAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([businessId])
  @@index([legacyKey])
  @@index([customerId])
  @@map("queue_entries")
}

enum ReservationStatus {
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  manageToken      String  @unique
  locationId       String  @db.ObjectId
  businessId       String  @db.ObjectId
  businessUsername String?
  customerId       String? @db.ObjectId

  firstName     String
  lastName      String
  name          String?
  guestCount    Int
  email         String
  phone         String?
  countryCode   String?
  contactMethod String?

  reservationDateTime String
  status              ReservationStatus @default(CONFIRMED)
  notes               String?
  source              String?

  needsReview           Boolean   @default(false)
  needsReviewReason     String?
  needsReviewNotifiedAt DateTime?

  reminderEmailSentAt DateTime?
  cancelledAt         DateTime?
  arrivedAt           DateTime?
  completedAt         DateTime?
  noShowAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId, status])
  @@index([locationId, needsReview])
  @@index([businessId])
  @@index([reservationDateTime])
  @@index([customerId])
  @@map("reservations_v2")
}

model GuestProfile {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?
  locationId       String  @db.ObjectId

  firstName String?
  lastName  String?
  fullName  String?

  phone           String?
  email           String?
  normalizedPhone String?
  normalizedEmail String?

  tags    String[] @default([])
  notes   String?
  summary String?

  totalVisits              Int @default(0)
  firstVisitAt             DateTime?
  lastVisitAt              DateTime?
  upcomingReservationCount Int @default(0)
  pastReservationCount     Int @default(0)
  waitlistVisitCount       Int @default(0)
  noShowCount              Int @default(0)
  cancelledCount           Int @default(0)

  sourceReservationIds String[] @default([])
  sourceQueueEntryIds  String[] @default([])

  emailMarketingOptIn       Boolean   @default(true)
  whatsappMarketingOptIn    Boolean   @default(true)
  smsMarketingOptIn         Boolean   @default(true)
  emailMarketingOptOutAt    DateTime?
  whatsappMarketingOptOutAt DateTime?
  smsMarketingOptOutAt      DateTime?
  marketingOptOutAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([locationId])
  @@index([businessId, locationId])
  @@index([normalizedPhone])
  @@index([normalizedEmail])
  @@index([tags])
  @@index([lastVisitAt])
  @@index([fullName])
  @@map("guest_profiles")
}

enum CampaignChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum CampaignTemplateType {
  SEATPING
  CUSTOM
}

enum CampaignTemplateApprovalStatus {
  DRAFT
  PENDING_SEATPING_REVIEW
  APPROVED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  READY
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELLED
  RECURRING
  PAUSED
}

enum CampaignSendMode {
  NOW
  SCHEDULED
  RECURRING
}

enum CampaignFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum CampaignRunType {
  MANUAL
  SCHEDULED
  RECURRING
}

enum CampaignRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model CampaignTemplate {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String? @db.ObjectId
  businessUsername String?
  locationId       String? @db.ObjectId

  templateType   CampaignTemplateType
  name           String
  slug           String?
  purpose        String?
  body           String
  offerDetails   String?
  ctaText        String?
  ctaUrl         String?
  variables      String[] @default([])
  exampleValues  Json     @default("{}")

  approvalStatus CampaignTemplateApprovalStatus @default(DRAFT)
  rejectionReason String?

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  internalReviewNotes          String?
  whatsappMetaStatus           String?
  whatsappProviderTemplateName String?
  whatsappProviderTemplateId   String?
  whatsappMetaCategory         String?
  whatsappLanguage             String? @default("en")
  whatsappSubmittedAt          DateTime?
  whatsappApprovedAt           DateTime?
  whatsappRejectedAt           DateTime?
  approvedBy                   String?
  rejectedBy                   String?

  submittedAt DateTime?
  approvedAt  DateTime?
  rejectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([templateType])
  @@index([approvalStatus])
  @@index([slug])
  @@map("campaign_templates")
}

model Campaign {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?
  locationId       String  @db.ObjectId

  name       String
  channel    CampaignChannel
  templateId String          @db.ObjectId

  templateValues Json @default("{}")

  audienceType   String
  audienceConfig Json   @default("{}")

  status         CampaignStatus @default(DRAFT)
  recipientCount Int            @default(0)
  excludedCount  Int            @default(0)
  sentCount      Int            @default(0)
  failedCount    Int            @default(0)
  skippedCount   Int            @default(0)

  sendMode  CampaignSendMode @default(NOW)
  timezone  String?
  scheduledAt DateTime?

  recurrenceFrequency CampaignFrequency?
  recurrenceStartAt   DateTime?
  recurrenceEndAt     DateTime?
  maxSendsPerGuestWindowDays Int?

  nextRunAt DateTime?
  lastRunAt DateTime?
  isPaused  Boolean   @default(false)

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([businessId])
  @@index([businessId, locationId])
  @@index([status])
  @@index([nextRunAt])
  @@map("campaigns")
}

model CampaignRun {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId String @db.ObjectId
  businessId String @db.ObjectId

  runType      CampaignRunType
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  status         CampaignRunStatus @default(PENDING)
  recipientCount Int               @default(0)
  sentCount      Int               @default(0)
  failedCount    Int               @default(0)
  skippedCount   Int               @default(0)
  errorMessage   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([businessId])
  @@map("campaign_runs")
}

model CampaignRecipient {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId     String  @db.ObjectId
  runId          String  @db.ObjectId
  businessId     String  @db.ObjectId
  guestProfileId String  @db.ObjectId

  channel CampaignChannel
  email   String?
  phone   String?

  status       CampaignRecipientStatus @default(PENDING)
  skipReason   String?
  errorMessage String?

  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, guestProfileId])
  @@index([campaignId])
  @@index([runId])
  @@index([businessId])
  @@index([campaignId, guestProfileId])
  @@map("campaign_recipients")
}

model CampaignDeliveryLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId  String  @db.ObjectId
  recipientId String? @db.ObjectId

  eventType         String
  providerMessageId String?
  message           String?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([recipientId])
  @@map("campaign_delivery_logs")
}

model SlotCounter {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  locationId     String @db.ObjectId
  dateKey        String
  hour           Int
  reservedGuests Int    @default(0)

  @@unique([locationId, dateKey, hour])
  @@map("slot_counters")
}

model SavedAudience {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId       String  @db.ObjectId
  businessUsername String?
  locationId       String  @db.ObjectId

  name        String
  description String?
  filters     Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, locationId])
  @@map("saved_audiences")
}

enum TableShape {
  ROUND
  SQUARE
  RECTANGLE
}

enum TableAssignmentSource {
  SMART
  MANUAL
}

enum TableAssignmentStatus {
  RESERVED
  SEATED
  COMPLETED
  CANCELLED
}

model FloorPlan {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  businessId String @db.ObjectId
  locationId String @db.ObjectId

  name      String @default("Main Dining Room")
  width     Int    @default(1200)
  height    Int    @default(800)
  sortOrder Int    @default(0)

  tables   DiningTable[]
  zones    FloorZone[]
  location Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, name])
  @@index([businessId])
  @@index([locationId, sortOrder])
  @@map("floor_plans")
}

model DiningTable {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  floorPlanId String @db.ObjectId
  businessId  String @db.ObjectId
  locationId  String @db.ObjectId

  name             String
  capacity         Int
  minimumPartySize Int    @default(1)

  shape TableShape @default(RECTANGLE)

  x        Int @default(0)
  y        Int @default(0)
  width    Int @default(120)
  height   Int @default(80)
  rotation Int @default(0)

  isBlocked     Boolean   @default(false)
  cleaningSince DateTime?

  assignmentVersion Int @default(0)

  floorPlan   FloorPlan         @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  assignments TableAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, name])
  @@index([floorPlanId])
  @@index([businessId])
  @@index([locationId, isBlocked])
  @@index([locationId, cleaningSince])
  @@map("dining_tables")
}

model TableAssignment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  tableId    String   @db.ObjectId
  tableIds   String[] @db.ObjectId
  businessId String   @db.ObjectId
  locationId String   @db.ObjectId

  queueEntryId   String? @db.ObjectId
  reservationId  String? @db.ObjectId
  guestProfileId String? @db.ObjectId

  partySize Int

  source TableAssignmentSource
  status TableAssignmentStatus @default(RESERVED)

  assignedAt      DateTime @default(now())
  expectedStartAt DateTime
  expectedEndAt   DateTime

  seatedAt    DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  table DiningTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tableId, status])
  @@index([tableIds])
  @@index([locationId, status])
  @@index([businessId])
  @@index([reservationId])
  @@index([queueEntryId])
  @@index([locationId, expectedStartAt])
  @@index([expectedEndAt])
  @@map("table_assignments")
}

model FloorZone {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  floorPlanId String @db.ObjectId
  businessId  String @db.ObjectId
  locationId  String @db.ObjectId

  name String

  x      Int @default(0)
  y      Int @default(0)
  width  Int @default(300)
  height Int @default(200)

  floorPlan FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floorPlanId, name])
  @@index([locationId])
  @@index([businessId])
  @@map("floor_zones")
}
