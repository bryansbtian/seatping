# SeatPing test environment variables.
# Copy this file to .env.test and adjust if your local setup differs.
# Never point these at a real database: the suites truncate collections.
# Unit tests (`npm test`) need none of this.

# --- Test Database ---
# Dedicated MongoDB replica set. The name must contain "test", and must not match
# DATABASE_URL or a managed cluster. Setup: see README.md.
TEST_DATABASE_URL="mongodb://localhost:27018/seatping_test?replicaSet=rs0&directConnection=true"

# --- Playwright E2E --- only for `npm run test:e2e`.
# Ports for the servers the suite starts, kept clear of `npm run dev` (4000 / 8080).
E2E_API_PORT="4100"
E2E_FRONTEND_PORT="8081"

# --- Smoke Tests --- only for `npm run test:smoke`.
# Deployment to run read-only checks against.
SMOKE_BASE_URL="http://localhost:4000"
